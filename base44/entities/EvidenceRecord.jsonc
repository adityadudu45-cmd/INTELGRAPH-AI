{
  "name": "EvidenceRecord",
  "type": "object",
  "properties": {
    "evidence_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "investigation_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Unreviewed",
        "Under Review",
        "Verified Sample Record",
        "Rejected",
        "Needs Correction"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red",
        "orange"
      ]
    },
    "analyst_notes": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "collected_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "verification_status",
    "investigation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}