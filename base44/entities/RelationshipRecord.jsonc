{
  "name": "RelationshipRecord",
  "type": "object",
  "properties": {
    "investigation_id": {
      "type": "string"
    },
    "source_entity_id": {
      "type": "string"
    },
    "target_entity_id": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    },
    "target_label": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "Associated in a sample incident",
        "Shared fictional event",
        "Recorded fictional transaction",
        "Shared simulated location event",
        "Organizational association",
        "Other analyst-reviewed relationship"
      ],
      "enumColors": [
        "orange",
        "blue",
        "yellow",
        "green",
        "purple",
        "gray"
      ]
    },
    "description": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "verification": {
      "type": "string",
      "enum": [
        "Confirmed",
        "Unverified",
        "Suggested"
      ],
      "enumColors": [
        "green",
        "yellow",
        "purple"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "Imported",
        "Manual",
        "AI-suggested"
      ],
      "enumColors": [
        "blue",
        "gray",
        "purple"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Unreviewed",
        "Under Review",
        "Verified Sample Record",
        "Rejected",
        "Needs Correction"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red",
        "orange"
      ]
    },
    "confidence": {
      "type": "number"
    }
  },
  "required": [
    "source_entity_id",
    "target_entity_id",
    "relationship_type",
    "investigation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}